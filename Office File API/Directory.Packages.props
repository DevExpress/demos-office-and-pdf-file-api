<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <DevExpressPackageVersion>26.2.2-beta</DevExpressPackageVersion>
  </PropertyGroup>
  <PropertyGroup>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>NU1604;NU1603;$(WarningsAsErrors)</WarningsAsErrors>
    <WarningsNotAsErrors>NU1901;NU1902;NU1903;NU1904;NU1510;DX1000;DX1001;DX1002;$(WarningsNotAsErrors)</WarningsNotAsErrors>
    <NoWarn>NU1507;$(NoWarn)</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageVersion Include="Markdig" Version="0.33.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
    <PackageVersion Include="OpenAI" Version="2.12.0" />
    <PackageVersion Include="DevExpress.AIIntegration.Docs" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Barcode" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Ocr" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Pdf" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Presentation" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Spreadsheet" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Word" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Document.Processor" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Blazor" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Docs.Core" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Drawing.Skia" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="DevExpress.Pdf.SkiaRenderer" Version="$(DevExpressPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.10" />
    <PackageVersion Include="Microsoft.ML.OnnxRuntime" Version="1.31.0" />
    <PackageVersion Include="System.Drawing.Common" Version="10.0.10" />
    <PackageVersion Include="SkiaSharp" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.HarfBuzz" Version="4.150.1" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
    <PackageVersion Include="HarfBuzzSharp.NativeAssets.Linux" Version="14.2.1.1" />
    <PackageVersion Include="Microsoft.ICU.ICU4C.Runtime" Version="72.1.0.3" />
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>
</Project>
