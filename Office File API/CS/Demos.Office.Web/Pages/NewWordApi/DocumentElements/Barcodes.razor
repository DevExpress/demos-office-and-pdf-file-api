@page "/NewWordApi/DocumentElements/Barcodes"
@using BlazorDemo.OfficeFileApi.Models.NewWordApi.DocumentElements
@inherits DemoPageComponentWithValidation<WordBarcodesModel>

@namespace BlazorDemo.OfficeFileApi.Pages.NewWordApi

<DemoPageMainLayout Loading="@loading" EditFormContext="@editFormContext">
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Symbology" ColSpanMd="4">
            <DxComboBox Data="model.BarcodeTypes" @bind-Value="model.BarcodeType"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Barcode Value" ColSpanMd="4">
            <DxTextBox @bind-Text="model.BarcodeValue" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Generate Barcode and Save as "
                                Data="@model.OutputFormats"
                                @bind-Value="model.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>


@code {
    async Task ProcessDownload()
    {
        await ProcessDownloadWithLoading(async () =>
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(model.BarcodeType.ToString()), "BarcodeType");
            content.Add(new StringContent(model.BarcodeValue), "BarcodeValue");
            AddCommonParameters(content, model.OutputFormat, model.OutputName);
            var apiUrl = "api/newwordapi/barcodes/generate";
            await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
        });
    }
}

