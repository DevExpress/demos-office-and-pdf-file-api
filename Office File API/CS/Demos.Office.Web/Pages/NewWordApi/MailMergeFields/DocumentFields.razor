@page "/NewWordApi/MailMergeFields/DocumentFields"
@using BlazorDemo.OfficeFileApi.Models.NewWordApi.MailMergeFields
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.NewWordApi

<DemoPageMainLayout Loading="@loading">
    <DocumentZoneLayoutItem>
        <DefaultFile @ref="defaultFileRef" DefaultDocuments="new List<string>() { DemoDocumentPaths.WordFieldTemplateFile }" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Field Action" ColSpanMd="4">
            <DxComboBox Data="@fieldModel.FieldActions" @bind-Value="fieldModel.Action"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Field Types" ColSpanMd="12">
            <DxListBox Data="@fieldModel.FieldEntryTypes" Enabled="@fieldModel.CanSelectFields"
                       @bind-Values="@fieldModel.FieldEntryValues"
                       TextFieldName="Text"
                       ValueFieldName="Value"
                       SelectionMode="ListBoxSelectionMode.Multiple"
                       ShowCheckboxes="true"
                       ShowSelectAllCheckbox="true">
            </DxListBox>
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Process Fields and Save as "
                                Data="@fieldModel.OutputFormats"
                                @bind-Value="fieldModel.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    DefaultFile defaultFileRef;
    // Model instance kept client-side only
    WordFieldsModel fieldModel = new WordFieldsModel();

    async Task ProcessDownload() {
        using var content = CreateMultipartContent(defaultFileRef?.DefaultFileInfoList.FirstOrDefault()?.Content);
        foreach (var value in fieldModel.FieldEntryValues ?? Array.Empty<string>())
            content.Add(new StringContent(value), "FieldEntryValues");
        content.Add(new StringContent(fieldModel.Action.ToString()), "Action");
        AddCommonParameters(content, fieldModel.OutputFormat, fieldModel.OutputName);

        var apiUrl = "api/newwordapi/fields/process";
        await ExecuteDownloadOperation(apiUrl, content, fieldModel.OutputName, fieldModel.OutputFormat);
    }
}