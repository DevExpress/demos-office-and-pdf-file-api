@page "/PdfProcessing/SearchExtract/PdfExtractText"
@using BlazorDemo.OfficeFileApi.Models.PdfProcessing.SearchExtract
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.PdfProcessing

<DemoPageMainLayout Loading="@loading" AdvancedOptionsZoneCaption="Page Range Settings">
    <DocumentZoneLayoutItem>
        <DemoUploader @ref="fileUploadRef"
                      AllowedFileExtensions="@model.AllowedFileExtensions"
                      DefaultDocument="@DemoDocumentPaths.PdfSampleAlternative" />
    </DocumentZoneLayoutItem>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Select Pages"
                          ColSpanMd="4">
            <DxComboBox Data="@model.ExportModes"
                        @bind-Value="model.ExportMode"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Custom Page Range"
                          ColSpanMd="4">
            <DxTextBox @bind-Text="model.PageRange"
                       NullText="1-3, 5, 7-10"
                       Enabled="@model.IsPageRangeEnabled" />
        </DxFormLayoutItem>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DownloadButton @ref="downloadButton"
                        Text="Extract Text"
                        Click="() => ProcessDownloadWithLoading(Process)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>


@code {
    // Model instance
    PdfExtractTextModel model = new PdfExtractTextModel();

    async Task Process() {
        using var content = CreateMultipartContent();
        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        // Add form parameters from model
        content.Add(new StringContent(model.ExportMode.ToString()), "ExportMode");
        if (model.IsPageRangeEnabled)
            content.Add(new StringContent(model.PageRange), "PageRange");

        var apiUrl = "api/pdfprocessing/pdf-search-extract/extract-text";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}
