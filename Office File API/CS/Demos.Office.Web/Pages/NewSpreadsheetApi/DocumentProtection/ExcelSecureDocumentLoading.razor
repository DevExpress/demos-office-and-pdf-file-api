@page "/NewSpreadsheetApi/DocumentProtection/SecureDocumentLoading"
@using BlazorDemo.OfficeFileApi.Models.NewSpreadsheetApi.DocumentProtection
@using DevExpress.Docs.Office
@inherits DemoPageComponentWithValidation<ExcelSecureDocumentLoadingModel>

@namespace BlazorDemo.OfficeFileApi.Pages.NewSpreadsheetApi

<DemoPageMainLayout Loading="@loading" AdvancedOptionsZoneCaption="Security Settings">
    <DocumentZoneLayoutItem>
        <DemoUploader @ref="fileUploadRef"
                      AllowedFileExtensions="@model.AllowedFileExtensions"
                      DefaultDocument="@DemoDocumentPaths.SpreadsheetSample" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="12">
            @loadingLog
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutGroup Caption="Loading Limits">
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Maximum Number of Worksheets" ColSpanMd="4">
                <DxSpinEdit @bind-Value="model.MaxWorksheetCount"
                            MinValue="1" MaxValue="10" Increment="1" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Maximum Rows per Worksheet" ColSpanMd="4">
                <DxSpinEdit @bind-Value="model.MaxSheetRowCount"
                            MinValue="1" MaxValue="500" Increment="100" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Maximum Cells per Worksheet" ColSpanMd="4">
                <DxSpinEdit @bind-Value="model.MaxSheetCellCount"
                            MinValue="1" MaxValue="1000" Increment="100" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Maximum Number of Charts" ColSpanMd="4">
                <DxSpinEdit @bind-Value="model.MaxChartCount"
                            MinValue="1" MaxValue="10" Increment="1" />
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
        <DxFormLayoutGroup Caption="Content Settings">
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Remove Content" ColSpanMd="4">
                <DxTagBox @bind-Values="SelectedContentValues"
                          TData="string"
                          TValue="string"
                          Data="@ListBoxData.Keys"
                          NullText="Select content to be removed"/>
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Convert Document to "
                                Data="@model.OutputFormats"
                                @bind-Value="model.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessConversion)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    string loadingLog = "Loading log will be displayed here.";
    IDictionary<string, bool> ListBoxData { get; set; }
    IEnumerable<string> SelectedContentValues { get; set; } = new List<string>();

    protected override void OnInitialized() {
        base.OnInitialized();
        ListBoxData = new Dictionary<string, bool>() {
                { "ActiveX Content", model.RemoveActiveXContent },
                { "Custom XML Parts", model.RemoveCustomXMLParts },
                { "External Connections", model.RemoveExternalConnections },
                { "External Workbooks", model.RemoveExternalWorkbooks },
                { "External Images", model.RemoveExternalImages },
                { "Macros", model.RemoveMacros },
                { "OLE Objects", model.RemoveOleObjects },
                { "Pivot Caches", model.RemovePivotCaches },
                { "Restricted Formulas", model.RemoveRestrictedFormulas },
                { "Restricted Links", model.RestrictedHyperlinkRemovalMode != RestrictedHyperlinkRemovalMode.None },
            };
        SelectedContentValues = ListBoxData.Where(x => x.Value).Select(x => x.Key).ToList();
    }

    void UpdateModelFromSelection() {
        foreach (var record in ListBoxData)
            ListBoxData[record.Key] = SelectedContentValues.Contains(record.Key);
        model.RemoveActiveXContent = ListBoxData["ActiveX Content"];
        model.RemoveCustomXMLParts = ListBoxData["Custom XML Parts"];
        model.RemoveExternalConnections = ListBoxData["External Connections"];
        model.RemoveExternalWorkbooks = ListBoxData["External Workbooks"];
        model.RemoveExternalImages = ListBoxData["External Images"];
        model.RemoveMacros = ListBoxData["Macros"];
        model.RemoveOleObjects = ListBoxData["OLE Objects"];
        model.RemovePivotCaches = ListBoxData["Pivot Caches"];
        model.RemoveRestrictedFormulas = ListBoxData["Restricted Formulas"];
        model.RestrictedHyperlinkRemovalMode = ListBoxData["Restricted Links"] ? RestrictedHyperlinkRemovalMode.UriOnly : RestrictedHyperlinkRemovalMode.None;
    }

    async Task ProcessConversion() {
        UpdateModelFromSelection();
        using var content = CreateMultipartContent();

        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        content.Add(new StringContent(model.MaxChartCount.ToString()), "MaxChartCount");
        content.Add(new StringContent(model.MaxSheetCellCount.ToString()), "MaxSheetCellCount");
        content.Add(new StringContent(model.MaxSheetRowCount.ToString()), "MaxSheetRowCount");
        content.Add(new StringContent(model.MaxWorksheetCount.ToString()), "MaxWorksheetCount");
        content.Add(new StringContent(model.RemoveActiveXContent.ToString()), "RemoveActiveXContent");
        content.Add(new StringContent(model.RemoveCustomXMLParts.ToString()), "RemoveCustomXMLParts");
        content.Add(new StringContent(model.RemoveExternalConnections.ToString()), "RemoveExternalConnections");
        content.Add(new StringContent(model.RemoveExternalWorkbooks.ToString()), "RemoveExternalWorkbooks");
        content.Add(new StringContent(model.RemoveExternalImages.ToString()), "RemoveExternalImages");
        content.Add(new StringContent(model.RemoveMacros.ToString()), "RemoveMacros");
        content.Add(new StringContent(model.RemoveOleObjects.ToString()), "RemoveOleObjects");
        content.Add(new StringContent(model.RemovePivotCaches.ToString()), "RemovePivotCaches");
        content.Add(new StringContent(model.RemoveRestrictedFormulas.ToString()), "RemoveRestrictedFormulas");
        content.Add(new StringContent(model.RestrictedHyperlinkRemovalMode.ToString()), "RestrictedHyperlinkRemovalMode");

        var apiUrl = "api/newspreadsheetapi/secure-document-loading/load";
        try {
            await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
            loadingLog = "Document loaded and processed successfully!";
        }
        catch (Exception ex) {
            loadingLog = $"Unable to load and process the document as it exceeds loading limits.{Environment.NewLine} Reason: \"{ex.Message}\"";
        }
    }
}
