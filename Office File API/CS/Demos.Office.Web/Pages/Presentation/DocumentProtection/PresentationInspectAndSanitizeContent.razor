@page "/Presentation/DocumentProtection/InspectAndSanitizeContent"
@using BlazorDemo.OfficeFileApi.Models.PowerPointPresentation.DocumentProtection
@using static BlazorDemo.OfficeFileApi.Models.PowerPointPresentation.DocumentProtection.PresentationInspectAndSanitizeContentModel
@inherits DemoPageComponentWithValidation<PresentationInspectAndSanitizeContentModel>

@namespace BlazorDemo.OfficeFileApi.Pages.Presentation

<DemoPageMainLayout Loading="@loading" AdvancedOptionsZoneCaption="Sanitize Settings">
    <DocumentZoneLayoutItem>
        <DemoUploader @ref="fileUploadRef"
                      AllowedFileExtensions="@model.AllowedFileExtensions"
                      DefaultDocument="@DemoDocumentPaths.PresentationSample" />
    </DocumentZoneLayoutItem>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Remove Hidden Content" ColSpanMd="6">
            <DxTagBox @bind-Values="SelectedHiddenContentValues"
                      TData="string"
                      TValue="string"
                      Data="@HiddenContentListBoxData.Keys" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Remove Sensitive Content" ColSpanMd="6">
            <DxTagBox @bind-Values="SelectedSensitiveContentValues"
                      TData="string"
                      TValue="string"
                      Data="@SensitiveContentListBoxData.Keys" />
        </DxFormLayoutItem>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DownloadButton @ref="downloadButton"
                        Text="Inspect Document and Save as TXT"
                        Click="() => ProcessDownloadWithLoading(Inspect)" />
        <DownloadButton Text="Sanitize Document and Save as PPTX"
                        Click="() => ProcessDownloadWithLoading(Sanitize)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    IDictionary<string, bool> HiddenContentListBoxData { get; set; }
    IDictionary<string, bool> SensitiveContentListBoxData { get; set; }
    IEnumerable<string> SelectedHiddenContentValues { get; set; } = new List<string>();
    IEnumerable<string> SelectedSensitiveContentValues { get; set; } = new List<string>();

    protected override void OnInitialized() {
        base.OnInitialized();
        HiddenContentListBoxData = new Dictionary<string, bool>() {
                { "Slides", model.RemoveHiddenSlides },
                { "Shapes", model.RemoveHiddenShapes }
            };
        SensitiveContentListBoxData = new Dictionary<string, bool>() {
                { "ActiveX Content", model.RemoveActiveXContent },
                { "Comments", model.RemoveComments },
                { "Custom XML Parts", model.RemoveCustomXMLParts },
                { "Embedded Chart Data", model.RemoveEmbeddedChartData },
                { "Macros", model.RemoveMacros },
                { "Metadata", model.RemoveMetadata },
                { "Notes", model.RemoveNotes },
                { "OLE Objects", model.RemoveOleObjects },
                { "Off-Slide Content", model.RemoveOffSlideContent },
            };
        SelectedHiddenContentValues = HiddenContentListBoxData.Where(x => x.Value).Select(x => x.Key).ToList();
        SelectedSensitiveContentValues = SensitiveContentListBoxData.Where(x => x.Value).Select(x => x.Key).ToList();
    }

    void UpdateModelFromSelections() {
        foreach (var record in HiddenContentListBoxData)
            HiddenContentListBoxData[record.Key] = SelectedHiddenContentValues.Contains(record.Key);
        model.RemoveHiddenSlides = HiddenContentListBoxData["Slides"];
        model.RemoveHiddenShapes = HiddenContentListBoxData["Shapes"];

        foreach (var record in SensitiveContentListBoxData)
            SensitiveContentListBoxData[record.Key] = SelectedSensitiveContentValues.Contains(record.Key);
        model.RemoveActiveXContent = SensitiveContentListBoxData["ActiveX Content"];
        model.RemoveComments = SensitiveContentListBoxData["Comments"];
        model.RemoveCustomXMLParts = SensitiveContentListBoxData["Custom XML Parts"];
        model.RemoveEmbeddedChartData = SensitiveContentListBoxData["Embedded Chart Data"];
        model.RemoveMacros = SensitiveContentListBoxData["Macros"];
        model.RemoveMetadata = SensitiveContentListBoxData["Metadata"];
        model.RemoveNotes = SensitiveContentListBoxData["Notes"];
        model.RemoveOleObjects = SensitiveContentListBoxData["OLE Objects"];
        model.RemoveOffSlideContent = SensitiveContentListBoxData["Off-Slide Content"];
    }
    async Task Inspect() {
        model.OperationType = InspectOperationType.Inspect;
        await Process();
    }
    async Task Sanitize() {
        model.OperationType = InspectOperationType.Sanitize;
        await Process();
    }
    async Task Process() {
        UpdateModelFromSelections();
        using var content = CreateMultipartContent();

        AddCommonParameters(content, model.OutputFileFormat, model.OutputFileName);

        content.Add(new StringContent(model.OperationType.ToString()), "OperationType");

        content.Add(new StringContent(model.RemoveHiddenSlides.ToString()), "RemoveHiddenSlides");
        content.Add(new StringContent(model.RemoveHiddenShapes.ToString()), "RemoveHiddenShapes");

        content.Add(new StringContent(model.RemoveActiveXContent.ToString()), "RemoveActiveXContent");
        content.Add(new StringContent(model.RemoveComments.ToString()), "RemoveComments");
        content.Add(new StringContent(model.RemoveEmbeddedChartData.ToString()), "RemoveEmbeddedChartData");
        content.Add(new StringContent(model.RemoveCustomXMLParts.ToString()), "RemoveCustomXMLParts");
        content.Add(new StringContent(model.RemoveMacros.ToString()), "RemoveMacros");
        content.Add(new StringContent(model.RemoveMetadata.ToString()), "RemoveMetadata");
        content.Add(new StringContent(model.RemoveNotes.ToString()), "RemoveNotes");
        content.Add(new StringContent(model.RemoveOleObjects.ToString()), "RemoveOleObjects");
        content.Add(new StringContent(model.RemoveOffSlideContent.ToString()), "RemoveOffSlideContent");

        var apiMethod = model.OperationType switch {
            InspectOperationType.Inspect => "inspect",
            InspectOperationType.Sanitize => "sanitize"
        };

        var apiUrl = $"api/presentation/secure-document-loading/{apiMethod}";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputFileName, model.OutputFileFormat);
    }
}
