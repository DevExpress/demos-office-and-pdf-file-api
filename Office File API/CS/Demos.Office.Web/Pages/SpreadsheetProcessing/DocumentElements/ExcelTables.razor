@page "/SpreadsheetProcessing/DocumentElements/Tables"
@using BlazorDemo.OfficeFileApi.Models.Spreadsheet.DocumentElements
@inherits DemoPageComponentWithValidation<ExcelTablesModel>

@namespace BlazorDemo.OfficeFileApi.Pages.SpreadsheetProcessing

<DemoPageMainLayout Loading="@loading" AdvancedOptionsZoneCaption="Table Settings" EditFormContext="@editFormContext">
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Number of Rows" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.NumberOfRows"
                        MinValue="1" MaxValue="10" Increment="1" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Number of Columns" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.NumberOfColumns"
                        MinValue="1" MaxValue="10" Increment="1" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
            <DxCheckBox @bind-Checked="model.CreateCustomTableStyle">
                Create Custom Table Style
            </DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
            <DxCheckBox @bind-Checked="model.ShowTotals">
                Show Totals
            </DxCheckBox>
        </DxFormLayoutItem>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Generate Table and Save as "
                                Data="@model.OutputFormats"
                                @bind-Value="model.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    async Task ProcessDownload() {
        // Create multipart form data
        using var content = new MultipartFormDataContent();

        // Add form parameters from model
        AddCommonParameters(content, model.OutputFormat, model.OutputName);
        content.Add(new StringContent(model.NumberOfRows.ToString()), "NumberOfRows");
        content.Add(new StringContent(model.NumberOfColumns.ToString()), "NumberOfColumns");
        content.Add(new StringContent(model.CreateCustomTableStyle.ToString()), "CreateCustomTableStyle");
        content.Add(new StringContent(model.ShowTotals.ToString()), "ShowTotals");

        // Call conversion API
        var apiUrl = "api/spreadsheetprocessing/tables/generate";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}
