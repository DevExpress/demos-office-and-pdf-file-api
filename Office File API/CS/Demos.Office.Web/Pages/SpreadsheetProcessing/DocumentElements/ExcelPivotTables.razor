@page "/SpreadsheetProcessing/DocumentElements/PivotTables"
@using BlazorDemo.OfficeFileApi.Models.Spreadsheet.DocumentElements
@inherits DemoPageComponentWithValidation<ExcelPivotTablesModel>

@namespace BlazorDemo.OfficeFileApi.Pages.SpreadsheetProcessing

<DemoPageMainLayout Loading="@loading" AdvancedOptionsZoneCaption="Pivot Table Settings" EditFormContext="@editFormContext">
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Filter by Sales Region" ColSpanMd="4">
            <DxComboBox Data="model.SalesRegions" @bind-Value="model.SalesRegion"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Report Layout" ColSpanMd="4">
            <DxComboBox Data="model.ReportLayoutTypes" @bind-Value="model.ReportLayout"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
            <DxCheckBox @bind-Checked="model.CreatePivotTableSheet">
                Create Pivot Table Sheet
            </DxCheckBox>
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutGroup Caption="Totals">
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.ShowRowGrandTotals">
                    Show Row Grand Totals
                </DxCheckBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.ShowColumnGrandTotals">
                    Show Column Grand Totals
                </DxCheckBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.ShowSubtotals">
                    Show Subtotals
                </DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
        <DxFormLayoutGroup Caption="Headers">
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.ShowRowHeaders">
                    Show Row Headers
                </DxCheckBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.ShowColumnHeaders">
                    Show Column Headers
                </DxCheckBox>
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
                <DxCheckBox @bind-Checked="model.ShowFieldHeaders">
                    Show Field Headers
                </DxCheckBox>
            </DxFormLayoutItem>
        </DxFormLayoutGroup>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Generate Pivot Table and Save as "
                                Data="@model.OutputFormats"
                                @bind-Value="model.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    async Task ProcessDownload() {
        // Create multipart form data
        using var content = new MultipartFormDataContent();

        // Add form parameters from model
        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        content.Add(new StringContent(model.CreatePivotTableSheet.ToString()), "CreatePivotTableSheet");
        content.Add(new StringContent(model.ReportLayout.ToString()), "ReportLayout");
        content.Add(new StringContent(model.ShowRowGrandTotals.ToString()), "ShowRowGrandTotals");
        content.Add(new StringContent(model.ShowColumnGrandTotals.ToString()), "ShowColumnGrandTotals");
        content.Add(new StringContent(model.ShowSubtotals.ToString()), "ShowSubtotals");
        content.Add(new StringContent(model.ShowRowHeaders.ToString()), "ShowRowHeaders");
        content.Add(new StringContent(model.ShowColumnHeaders.ToString()), "ShowColumnHeaders");
        content.Add(new StringContent(model.ShowFieldHeaders.ToString()), "ShowFieldHeaders");
        content.Add(new StringContent(model.SalesRegion.ToString()), "SalesRegion");

        // Call conversion API
        var apiUrl = "api/spreadsheetprocessing/pivot-tables/generate";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}
