@page "/NewPdfDocumentApi/GenerateDocument/PdfGenerateInvoice"
@using BlazorDemo.OfficeFileApi.Models.NewPdfDocumentApi.GenerateDocument
@using System.Net.Http.Headers
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.NewPdfDocumentApi

<DemoPageMainLayout Loading="@loading">
    <DocumentZoneLayoutItem>
        <DefaultFile @ref="xmlFileRef"
                     Title="ZUGFeRD Invoice XML"
                     DefaultDocuments="new List<string>() { DemoDocumentPaths.PdfNorthwindInvoice }" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem ColSpanMd="4">
            <DxCheckBox @bind-Checked="model.IncludeZugferd">
                Include ZUGFeRD Invoice
            </DxCheckBox>
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DownloadButton @ref="downloadButton"
                        Text="Generate Invoice"
                        Click="() => ProcessDownloadWithLoading(Process)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    PdfGenerateInvoiceModel model = new PdfGenerateInvoiceModel();
    DefaultFile xmlFileRef;

    async Task Process() {
        using var content = new MultipartFormDataContent();
        AddCommonParameters(content, model.OutputFormat, model.OutputName);
        content.Add(new StringContent(model.IncludeZugferd.ToString()), "IncludeZugferd");
        if(model.IncludeZugferd && xmlFileRef?.DefaultFileInfoList?[0].Content != null) {
            var xmlContent = new StreamContent(new MemoryStream(xmlFileRef.DefaultFileInfoList[0].Content));
            xmlContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
            content.Add(xmlContent, "xmlFile", "invoice.xml");
        }
        await ExecuteDownloadOperation(
            "api/newpdfdocumentapi/generate-document/generate-invoice",
            content, model.OutputName, model.OutputFormat.ToString());
    }
}
