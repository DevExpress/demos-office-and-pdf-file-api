@page "/NewPdfDocumentApi/DocumentElements/PdfAttachments"
@using BlazorDemo.OfficeFileApi.Models.NewPdfDocumentApi.DocumentElements
@using System.Net.Http.Headers
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.NewPdfDocumentApi

<DemoPageMainLayout Loading="@loading">
    <DocumentZoneLayoutItem>
        <DemoUploader @ref="fileUploadRef"
                      AllowedFileExtensions="@model.AllowedFileExtensions"
                      DefaultDocument="@DemoDocumentPaths.PdfSampleAlternative" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Attachment Image"
                          ColSpanMd="4"
                          BeginRow="true">
            <img id="defaultImage"
                 src="@($"data:png;base64,{Convert.ToBase64String(attachmentImageBytes ?? Array.Empty<byte>())}")"
                 width="192"
                 height="32"
                 alt="Default image" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DownloadButton @ref="downloadButton"
                        Text="Add Attachment and Save"
                        Click="() => ProcessDownloadWithLoading(Process)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>


@code {
    byte[] attachmentImageBytes;
    PdfAttachmentsModel model = new PdfAttachmentsModel();

    protected override void OnInitialized() {
        base.OnInitialized();
        attachmentImageBytes = System.IO.File.ReadAllBytes(DemoDocumentPaths.DevExpressLogo);
    }

    async Task Process() {
        using var content = CreateMultipartContent();
        AddCommonParameters(content, model.OutputFormat, model.OutputName);

        var streamContent = new StreamContent(new MemoryStream(attachmentImageBytes));
        streamContent.Headers.ContentType = new MediaTypeHeaderValue("application/octet-stream");
        content.Add(streamContent, "attachment", DemoDocumentPaths.DevExpressLogo);

        var apiUrl = "api/newpdfdocumentapi/pdf-attachments/attach";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat.ToString());
    }
}
