@page "/WordProcessing/MailMergeFields/TableOfContents"
@using BlazorDemo.OfficeFileApi.Models.WordProcessing.MailMergeFields
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.WordProcessing

<DemoPageMainLayout Loading="@loading" AdvancedOptionsZoneCaption="Table of Contents Settings">
    <DocumentZoneLayoutItem>
        <DefaultFile @ref="defaultFileRef" DefaultDocuments="new List<string>() { DemoDocumentPaths.WordTableOfContentsTemplateFile }" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="TOC Entries" ColSpanMd="4">
            <DxComboBox Data="@tocModel.InsertModes" @bind-Value="tocModel.InsertMode"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Start Level" ColSpanMd="4">
            <DxSpinEdit @bind-Value="tocModel.StartLevel" Min="1" Max="9" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="End Level" ColSpanMd="4">
            <DxSpinEdit @bind-Value="tocModel.EndLevel" Min="1" Max="9" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <AdvancedOptionsZoneLayoutGroup>
        @if (tocModel.IncludePageNumbers) {
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Tab Leader" ColSpanMd="4">
                <DxComboBox Data="@tocModel.TabLeaderTypes" @bind-Value="tocModel.TabLeaderType"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>
        }
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
            <DxCheckBox @bind-Checked="tocModel.UseHyperlinks">Hyperlinks</DxCheckBox>
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" ColSpanMd="4">
            <DxCheckBox @bind-Checked="tocModel.IncludePageNumbers">Page Numbers</DxCheckBox>
        </DxFormLayoutItem>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Generate Table of Contents and Save as "
                                Data="@tocModel.OutputFormats"
                                @bind-Value="tocModel.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    DefaultFile defaultFileRef;
    // Model instance kept client-side only
    WordTableOfContentsModel tocModel = new WordTableOfContentsModel();

    async Task ProcessDownload() {
        using var content = CreateMultipartContent(defaultFileRef?.DefaultFileInfoList.FirstOrDefault()?.Content);
        content.Add(new StringContent(tocModel.InsertMode.ToString()), "InsertMode");
        content.Add(new StringContent(tocModel.StartLevel.ToString()), "StartLevel");
        content.Add(new StringContent(tocModel.EndLevel.ToString()), "EndLevel");
        content.Add(new StringContent(tocModel.UseHyperlinks.ToString()), "UseHyperlinks");
        content.Add(new StringContent(tocModel.IncludePageNumbers.ToString()), "IncludePageNumbers");
        content.Add(new StringContent(tocModel.TabLeaderType.ToString()), "TabLeaderType");
        AddCommonParameters(content, tocModel.OutputFormat, tocModel.OutputName);

        var apiUrl = "api/wordprocessing/toc/process";
        await ExecuteDownloadOperation(apiUrl, content, tocModel.OutputName, tocModel.OutputFormat);
    }
}


