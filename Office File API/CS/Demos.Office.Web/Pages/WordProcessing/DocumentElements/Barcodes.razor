@page "/WordProcessing/DocumentElements/Barcodes"
@using BlazorDemo.OfficeFileApi.Models.WordProcessing.DocumentElements
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.WordProcessing

<DemoPageMainLayout Loading="@loading">
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Symbology" ColSpanMd="4">
            <DxComboBox Data="barcodeModel.BarcodeTypes" @bind-Value="barcodeModel.BarcodeType"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Barcode Value" ColSpanMd="4">
            <DxTextBox @bind-Text="barcodeModel.BarcodeValue" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Generate Barcode and Save as "
                                Data="@barcodeModel.OutputFormats"
                                @bind-Value="barcodeModel.OutputFormat"
                                Click="ProcessDownload" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>


@code {
    WordBarcodesModel barcodeModel = new WordBarcodesModel();

    async Task ProcessDownload()
    {
        await ProcessDownloadWithLoading(async () =>
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(barcodeModel.BarcodeType.ToString()), "BarcodeType");
            content.Add(new StringContent(barcodeModel.BarcodeValue), "BarcodeValue");
            AddCommonParameters(content, barcodeModel.OutputFormat, barcodeModel.OutputName);
            var apiUrl = "api/wordprocessing/barcodes/generate";
            await ExecuteDownloadOperation(apiUrl, content, barcodeModel.OutputName, barcodeModel.OutputFormat);
        });
    }
}


