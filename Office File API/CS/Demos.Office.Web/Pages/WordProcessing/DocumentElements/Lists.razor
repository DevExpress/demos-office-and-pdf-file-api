@page "/WordProcessing/DocumentElements/Lists"
@using BlazorDemo.OfficeFileApi.Models.WordProcessing.DocumentElements
@inherits DemoPageComponentWithValidation<WordListsModel>

@namespace BlazorDemo.OfficeFileApi.Pages.WordProcessing

<DemoPageMainLayout Loading="@loading" EditFormContext="@editFormContext" AdvancedOptionsZoneCaption="Additional Settings">
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="List Type" ColSpanMd="4">
            <DxComboBox Data="@model.ListTypes" @bind-Value="model.ListType"
                        TextFieldName="Text" ValueFieldName="Value" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Number of Items" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.NumberOfItems"
                        MinValue="1" MaxValue="20" Increment="1" />
        </DxFormLayoutItem>
        @if (model.IsBulletList()) {
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Bullet Style" ColSpanMd="4">
                <DxComboBox Data="@model.BulletStyles" @bind-Value="model.BulletStyle"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>
            @if (model.IsCustomBullet()) {
                <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Custom Bullet Text" ColSpanMd="4">
                    <DxTextBox @bind-Text="model.CustomBulletText" />
                </DxFormLayoutItem>
            }
        }
        @if (model.IsNumberingList()) {
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Numbering Format" ColSpanMd="4">
                <DxComboBox Data="@model.NumberingFormats" @bind-Value="model.NumberingFormat"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Start Number" ColSpanMd="4">
                <DxSpinEdit @bind-Value="model.StartNumber"
                            MinValue="1" MaxValue="1000" Increment="1" />
            </DxFormLayoutItem>
        }
        @if (model.IsMultilevelList()) {
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Multilevel Style" ColSpanMd="4">
                <DxComboBox Data="@model.MultilevelStyles" @bind-Value="model.MultilevelStyle"
                            TextFieldName="Text" ValueFieldName="Value" />
            </DxFormLayoutItem>
            <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Maximum Levels" ColSpanMd="4">
                <DxSpinEdit @bind-Value="model.MaxLevels"
                            MinValue="1" MaxValue="3" Increment="1" />
            </DxFormLayoutItem>
        }
    </MainOptionsZoneLayoutGroup>
    <AdvancedOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Indent" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.IndentSize"
                        MinValue="0f" MaxValue="5f" Increment="0.1f" DisplayFormat="0.0 \'\'" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="First Line Indent" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.HangingIndent"
                        MinValue="0f" MaxValue="2f" Increment="0.1f" DisplayFormat="0.0 \'\'" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Spacing Before" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.SpaceBefore"
                        MinValue="0" MaxValue="72" Increment="6" DisplayFormat="0 pt" />
        </DxFormLayoutItem>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical" Caption="Spacing After" ColSpanMd="4">
            <DxSpinEdit @bind-Value="model.SpaceAfter"
                        MinValue="0" MaxValue="72" Increment="6" DisplayFormat="0 pt" />
        </DxFormLayoutItem>
    </AdvancedOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                Text="Generate List and Save as "
                                Data="@model.OutputFormats"
                                @bind-Value="model.OutputFormat"
                                Click="() => ProcessDownloadWithLoading(ProcessDownload)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    async Task ProcessDownload() {
        using var content = new MultipartFormDataContent();
        content.Add(new StringContent(model.BulletStyle.ToString()), "BulletStyle");
        content.Add(new StringContent(model.CustomBulletText ?? string.Empty), "CustomBulletText");
        content.Add(new StringContent(model.HangingIndent.ToString()), "HangingIndent");
        content.Add(new StringContent(model.IndentSize.ToString()), "IndentSize");
        content.Add(new StringContent(model.ListType.ToString()), "ListType");
        content.Add(new StringContent(model.MaxLevels.ToString()), "MaxLevels");
        content.Add(new StringContent(model.MultilevelStyle.ToString()), "MultilevelStyle");
        content.Add(new StringContent(model.NumberingFormat.ToString()), "NumberingFormat");
        content.Add(new StringContent(model.NumberOfItems.ToString()), "NumberOfItems");
        content.Add(new StringContent(model.SpaceAfter.ToString()), "SpaceAfter");
        content.Add(new StringContent(model.SpaceBefore.ToString()), "SpaceBefore");
        content.Add(new StringContent(model.StartNumber.ToString()), "StartNumber");
        AddCommonParameters(content, model.OutputFormat, model.OutputName);
        var apiUrl = "api/wordprocessing/lists/generate";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}


