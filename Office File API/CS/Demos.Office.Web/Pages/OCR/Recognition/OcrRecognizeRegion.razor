@page "/OCR/Recognition/OcrRecognizeRegion"
@using BlazorDemo.OfficeFileApi.Models.OCR.Recognition
@inherits DemoPageComponentBase

@namespace BlazorDemo.OfficeFileApi.Pages.OCR.Recognition

<DemoPageMainLayout Loading="@loading">
    <DocumentZoneLayoutItem>
        <DefaultFile @ref="regionsFileRef"
                     DefaultDocuments="new List<string>() { DemoDocumentPaths.OcrSampleRegionsPdf }" />
    </DocumentZoneLayoutItem>
    <MainOptionsZoneLayoutGroup>
        <DxFormLayoutItem CaptionPosition="CaptionPosition.Vertical"
                          Caption="Region to Recognize"
                          ColSpanMd="4">
            <DxComboBox Data="@model.Regions"
                        @bind-Value="model.Region"
                        TextFieldName="Text"
                        ValueFieldName="Value" />
        </DxFormLayoutItem>
    </MainOptionsZoneLayoutGroup>
    <ButtonZoneLayoutItem>
        <DropDownDownloadButton @ref="downloadButton"
                                @bind-Value="model.OutputFormat"
                                Data="@model.OutputFormats"
                                Text="Recognize and export to"
                                Click="() => ProcessDownloadWithLoading(Process)" />
    </ButtonZoneLayoutItem>
</DemoPageMainLayout>

@code {
    DefaultFile regionsFileRef;
    OcrRecognizeRegionModel model = new OcrRecognizeRegionModel();

    async Task Process() {
        using var content = CreateMultipartContent(regionsFileRef.DefaultFileInfoList[0].Content);
        AddCommonParameters(content, model.OutputFormat, model.OutputName);
        content.Add(new StringContent(model.Region.ToString()), "Region");

        var apiUrl = "api/ocr/recognition/recognize-region";
        await ExecuteDownloadOperation(apiUrl, content, model.OutputName, model.OutputFormat);
    }
}
