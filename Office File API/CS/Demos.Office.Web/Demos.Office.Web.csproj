<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
		<RootNamespace>BlazorDemo.OfficeFileApi</RootNamespace>
		<AssemblyName>BlazorDemo.OfficeFileApi.Server</AssemblyName>
		<CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
		<GenerateRuntimeConfigDevFile>true</GenerateRuntimeConfigDevFile>
		<AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
		<EnableDefaultItems>false</EnableDefaultItems>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

	<ItemGroup>
		<EmbeddedResource Include="appsettings.json" />
		<EmbeddedResource Include="demo-metadata.json" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="wwwroot\**\*.*" />
		<Compile Include="Controllers\**\*.cs" />
		<Compile Include="Data\*.cs" />
		<Compile Include="DemoShell\**\*.cs" />
		<Content Include="DemoShell\**\*.razor" />
		<Content Include="DemoShell\**\*.razor.css" />
		<Content Include="DemoShell\**\*.razor.js" />
		<Content Include="Documents\**\*.*">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
		<Compile Include="Models\**\*.cs" />
		<Compile Include="Pages\**\*.cs" />
		<Content Include="Pages\**\*.razor" />
		<Content Include="Pages\**\*.razor.css" />
		<Content Include="Pages\**\*.razor.js" />
		<Content Include="Pages\**\*.md" />
		<Compile Include="Services\**\*.cs" />
		<Compile Include="Shared\**\*.cs" />
		<Content Include="Shared\**\*.razor" />
		<Content Include="Shared\**\*.razor.css" />
		<Content Include="Shared\**\*.razor.js" />
		<Compile Include="Utils\**\*.cs" />
		<Compile Include="*.cs" />
		<Content Include="*.razor" />
		<Content Include="*.razor.css" />
		<Content Include="*.razor.js" />
		<Content Include="*.json" />
    <Content Include="appsettings.json" CopyToOutputDirectory="Always" CopyToPublishDirectory="Always" />
	</ItemGroup>

	<ItemGroup>
    <PackageReference Include="Markdig" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="Microsoft.Extensions.AI" />
    <PackageReference Include="OpenAI" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <!-- Skia rendering backend for DevExpress.Drawing on non-Windows (image export, e.g. PPTX -> image). -->
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.HarfBuzz" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="Microsoft.ICU.ICU4C.Runtime" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
	</ItemGroup>
	<ItemGroup>
    <PackageReference Include="DevExpress.AIIntegration.Docs" />
    <PackageReference Include="DevExpress.Blazor" />
    <PackageReference Include="DevExpress.Docs.Barcode" />
    <PackageReference Include="DevExpress.Docs.Ocr" />
    <PackageReference Include="DevExpress.Docs.Pdf" />
    <PackageReference Include="DevExpress.Docs.Spreadsheet" />
    <PackageReference Include="DevExpress.Docs.Word" />
    <PackageReference Include="DevExpress.Drawing.Skia" />
	</ItemGroup>
  <ItemGroup>
		<DotnetPublishFiles Include="wwwroot/**;*.json">
			<DestinationRelativePath>%(RelativeDir)%(Filename)%(Extension)</DestinationRelativePath>
		</DotnetPublishFiles>
	</ItemGroup>
  <ItemGroup>
		<Content Include="NOTICE.txt" />
	</ItemGroup>
  <ItemGroup>
    <Folder Include="Pages\WordProcessing\ReviewComment\Descriptions\" />
  </ItemGroup>



	<Target Name="SourceCode" BeforeTargets="PreBuildEvent">
		<ItemGroup>
			<Message Text="Embedding source code" />
			<EmbeddedResource Include="Pages\**\*.*" />
			<EmbeddedResource Include="Data\**\*.*" />
			<EmbeddedResource Include="Services\**\*.*" />
			<EmbeddedResource Include="Controllers\**\*.*" />
			<EmbeddedResource Include="Shared\**\*.*" />
			<EmbeddedResource Include="wwwroot\css\*.css" />
		</ItemGroup>
	</Target>
  
</Project>
