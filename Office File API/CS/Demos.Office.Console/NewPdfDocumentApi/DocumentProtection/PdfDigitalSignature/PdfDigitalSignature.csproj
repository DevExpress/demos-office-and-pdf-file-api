<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Docs.Pdf" />
    <PackageReference Include="DevExpress.Document.Processor" />
    <PackageReference Include="DevExpress.Pdf.SkiaRenderer" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\Documents\PDF\Sample_Unsigned.pdf">
      <Link>Documents\PDF\Sample_Unsigned.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Documents\PDF\Sample_Certificate.pfx">
      <Link>Documents\PDF\Sample_Certificate.pfx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Documents\PDF\Signature_Background.png">
      <Link>Documents\PDF\Signature_Background.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Documents\DevExpress.png">
      <Link>Documents\DevExpress.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
    <PackageReference Include="System.Drawing.Common" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" />
  </ItemGroup>
</Project>