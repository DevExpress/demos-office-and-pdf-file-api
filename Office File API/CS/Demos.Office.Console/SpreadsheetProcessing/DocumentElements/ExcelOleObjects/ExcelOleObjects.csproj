  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="DevExpress.Document.Processor" Version="26.1.3" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\Documents\InvestmentPortfolio.xlsx">
      <Link>Documents\InvestmentPortfolio.xlsx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Documents\Excel.png">
      <Link>Documents\Excel.png</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
