<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DevExpress.Docs.Core" />
    <PackageReference Include="DevExpress.Document.Processor" />
    <PackageReference Include="DevExpress.Pdf.SkiaRenderer" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\Documents\PDF\Sample_Form.pdf">
      <Link>Documents\PDF\Sample_Form.pdf</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\..\Documents\PDF\Sample_FormData.xml">
      <Link>Documents\PDF\Sample_FormData.xml</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="HarfBuzzSharp.NativeAssets.Linux" />
    <PackageReference Include="SkiaSharp" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" />
  </ItemGroup>
</Project>