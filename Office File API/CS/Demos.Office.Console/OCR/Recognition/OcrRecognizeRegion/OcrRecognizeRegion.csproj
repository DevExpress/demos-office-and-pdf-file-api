  <ItemGroup>
    <Content Include="..\..\..\Documents\OCR\Report_Scan.pdf"><Link>Documents\OCR\Report_Scan.pdf</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory></Content>
