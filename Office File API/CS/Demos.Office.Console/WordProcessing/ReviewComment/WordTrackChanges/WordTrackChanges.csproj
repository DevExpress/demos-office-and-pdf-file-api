<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseSystemDrawing>true</UseSystemDrawing>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="8.0.15" />
    <PackageReference Include="DevExpress.Document.Processor" Version="26.1.3" />
    <PackageReference Include="DevExpress.Drawing.Skia" Version="26.1.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\..\Documents\TrackChanges_template.docx">
      <Link>Documents\TrackChanges_template.docx</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>
